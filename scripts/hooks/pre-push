#!/bin/sh
# Block direct pushes to main and develop — use a PR instead.

protected="main develop"
current=$(git symbolic-ref --short HEAD 2>/dev/null)

for branch in $protected; do
  if [ "$current" = "$branch" ]; then
    echo "✗ Direct push to '$branch' is blocked. Open a PR from a feature/* or fix/* branch."
    exit 1
  fi
done

exit 0
